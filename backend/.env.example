# ---------- Server ----------
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-this-super-secret

# ---------- Postgres ----------
DATABASE_URL="postgresql://reachinbox:reachinbox@localhost:5432/reachinbox?schema=public"

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- Elasticsearch ----------
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ---------- Ethereal SMTP ----------
# Create test accounts at https://ethereal.email or programmatically via nodemailer.createTestAccount()
# You can configure multiple senders as a JSON array of {name,user,pass,host,port}
ETHEREAL_SENDERS=[{"name":"Sender One","host":"smtp.ethereal.email","port":587,"user":"REPLACE_ME@ethereal.email","pass":"REPLACE_ME"}]

# ---------- Rate limiting / concurrency ----------
WORKER_CONCURRENCY=5
MIN_DELAY_MS_BETWEEN_SENDS=2000
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ---------- Slack OAuth ----------
SLACK_CLIENT_ID=replace-me
SLACK_CLIENT_SECRET=replace-me
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/oauth/callback
# Slack scopes needed to post messages via incoming-webhook style OAuth
SLACK_SCOPES=incoming-webhook,chat:write
